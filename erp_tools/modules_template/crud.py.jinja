    except SQLAlchemyError as e:
        db.rollback()
        logging.error(f"SQLAlchemyError: {e}")
        return None
    except Exception as e:
        db.rollback()
        logging.error(e)
        return None


# Update method patch, jadi bisa diupdate salah satu kolom / bbrp kolom saja. tanpa pengecekan required dahulu
async def partial_update_data_{{ fitur }}(db: Session, {{ pk }}: int, {{ fitur }}_data_update: dict, identity: TokenData):
    try:
        old_patch_{{ fitur }} = await check_{{ fitur }}(db, {{ pk }}={{ pk }})
        if old_patch_{{ fitur }}:
            # Update fields only if they are present in the provided data
            for field, value in {{ fitur }}_data_update.items():
                if hasattr(old_patch_{{ fitur }}, field):
                    setattr(old_patch_{{ fitur }}, field, value)

            # Update data flag
{% if has_revised %}
            old_patch_{{ fitur }}.revised = (old_patch_{{ fitur }}.revised or 0) + 1
{% endif %}
{% if has_updated %}
            old_patch_{{ fitur }}.updated_by = identity.user_name
            old_patch_{{ fitur }}.updated_at = datetime.now()
{% endif %}

            db.commit()
            db.refresh(old_patch_{{ fitur }})

            return await json_{{ fitur }}(
                db=db,
                {{ fitur }}_data_row=old_patch_{{ fitur }}
            )
        else:
            return None
    except IntegrityError as e:
        db.rollback()
        logging.error(f"IntegrityError: {e}")
        return None  # Tangani kesalahan unik di endpoint
    except SQLAlchemyError as e:
        db.rollback()
        logging.error(f"SQLAlchemyError: {e}")
        return None
    except Exception as e:
        db.rollback()
        logging.error(f"Exception: {e}")
        return None


async def delete_data_{{ fitur }}(db: Session, {{ pk }}: int, identity: TokenData):
    try:
        deleted_{{ fitur }} = await check_{{ fitur }}(db, {{ pk }}={{ pk }})
        if not deleted_{{ fitur }}:
            return None
{% if has_deleted_at %}

{% if aktif_column and aktif_column.has_tidak_aktif %}
        deleted_{{ fitur }}.{{ aktif_column.name }} = 'Tidak Aktif'
{% endif %}
{% if has_deleted_by %}
        deleted_{{ fitur }}.deleted_by = identity.user_name
{% endif %}
        deleted_{{ fitur }}.deleted_at = datetime.now()

        db.commit()
        db.refresh(deleted_{{ fitur }})

        return await json_{{ fitur }}(
            db=db,
            {{ fitur }}_data_row=deleted_{{ fitur }}
        )
{% else %}

        # Table tidak punya kolom deleted_at -> hapus permanen
        data_{{ fitur }} = await json_{{ fitur }}(db=db, {{ fitur }}_data_row=deleted_{{ fitur }})
        db.delete(deleted_{{ fitur }})
        db.commit()

        return data_{{ fitur }}
{% endif %}
    except IntegrityError as e:
        db.rollback()
        logging.error(f"IntegrityError: {e}")
        return None  # Tangani kesalahan unik di endpoint
    except SQLAlchemyError as e:
        db.rollback()
        logging.error(f"SQLAlchemyError: {e}")
        return None
    except Exception as e:
        db.rollback()
        logging.error(e)
        return None

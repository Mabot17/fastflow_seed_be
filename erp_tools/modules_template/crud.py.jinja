    try:
        old_{{ fitur }} = await check_{{ fitur }}(db, {{ pk }}={{ pk }})
        if old_{{ fitur }}:
{% for c in data_columns %}
            old_{{ fitur }}.{{ c.attr }} = {{ fitur }}_data_update.{{ c.name }}
{% endfor %}

            # Update data flag
{% if has_revised %}
            old_{{ fitur }}.revised = (old_{{ fitur }}.revised or 0) + 1
{% endif %}
{% if has_updated %}
            old_{{ fitur }}.updated_by = identity.user_name

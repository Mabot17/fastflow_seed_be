# Salin file ini menjadi erp_api/core/.env lalu sesuaikan. File .env JANGAN di-push.

# ---------- Aplikasi ----------
# Prefix path bila API berada di belakang reverse proxy, contoh: /api
ROOT_PATH=
# Origin yang diizinkan CORS, pisahkan dengan koma. "*" = semua (hanya untuk development)
CORS_ORIGINS=*
# 1 = jalankan job terjadwal (aktifkan di SATU instance saja bila memakai beberapa worker)
ENABLE_SISTEM_JOB=0

# ---------- Folder file statis / upload / log (kosong = <root repo>/erp_statics) ----------
STATIC_FILES_FOLDER=

# ---------- Database ----------
DB_CONNECTION_URL=mysql+pymysql://user:password@127.0.0.1:3306/seed_koffie?charset=utf8mb4

# ---------- Token JWT ----------
# Wajib diganti dengan string acak panjang, contoh: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=ganti-dengan-string-acak-panjang
ACCESS_TOKEN_EXPIRE_DAYS=1
